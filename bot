@dp.callback_query(F.data.startswith("prov_"))
async def province_call(callback: types.CallbackQuery):
    province_name = callback.data.replace("prov_", "")
    await callback.answer(text=f"🚨 إسعاف {province_name}: 911", show_alert=True)

@dp.message()
async def handle_text_search(message: types.Message):
    if not message.text or message.text.startswith("/") or "🔍" in message.text or "🚑" in message.text: return
    wait_msg = await message.answer(f"⏳ جاري البحث عن '{message.text}'...")
    results = quick_search(message.text)
    if results:
        res = results[0]
        await wait_msg.delete()
        await message.answer(f"✅ تم العثور على: {res['display_name'].split(',')[0]}")
        await message.answer_location(latitude=float(res['lat']), longitude=float(res['lon']))
    else:
        await wait_msg.edit_text("❌ لم يتم العثور على نتائج.")

