# ✅ مصلح: معالجة الموقع الجغرافي
@dp.message(F.location)
async def handle_location(message: types.Message):
    wait_msg = await message.answer("⏳ جاري البحث عن أقرب مستشفى لموقعك الحالي...")
    results = search_nearest_medical(message.location.latitude, message.location.longitude)
    
    await wait_msg.delete() # حذف رسالة الانتظار
    
    if results:
        res = results[0]
        lat = res.get('lat') or res.get('center', {}).get('lat')
        lon = res.get('lon') or res.get('center', {}).get('lon')
        name = res.get('tags', {}).get('name:ar') or res.get('tags', {}).get('name', 'مرفق طبي قريب')
        
        await message.answer(f"✅ أقرب نتيجة لموقعك:\n🏥 {name}")
        await message.answer_location(latitude=lat, longitude=lon)
    else:
        await message.answer("❌ لم يتم العثور على مستشفيات قريبة في نطاق")
 
@dp.message(F.text == "🚑 أرقام الإسعاف (المحافظات)")
async def show_provinces(message: types.Message):
